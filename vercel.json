{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:static",
  "outputDirectory": "dist/public",
  "functions": {
    "api/[...path].ts": { "maxDuration": 10 },
    "api/auth/login.ts": { "maxDuration": 10 },
    "api/auth/register.ts": { "maxDuration": 10 },
    "api/auth/logout.ts": { "maxDuration": 10 },
    "api/auth/me.ts": { "maxDuration": 10 },
    "api/auth/request-reset.ts": { "maxDuration": 15 },
    "api/auth/reset-password.ts": { "maxDuration": 15 },
    "api/health.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/admin/dashboard", "destination": "/api/trpc/admin-dashboard" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/admin/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/high-dam", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/quran", "destination": "/index.html" },
    { "source": "/404", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
